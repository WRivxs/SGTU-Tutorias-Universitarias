# ==========================================
# Root .gitignore - SGTU Monorepo
# ==========================================

# IDE & Editor files
.idea/
*.iws
*.iml
*.ipr
.vscode/
.settings/
.project
.classpath
.factorypath
.apt_generated
.springBeans
.sts4-cache
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.DS_Store
Thumbs.db

# Environment & Credentials
.env
*.pem
*.key
application-local.yml
application-local.properties
run-local.ps1
run-local.bat

# ==========================================
# Backend (Java / Maven / Spring Boot)
# ==========================================
backend/target/
target/
HELP.md
!.mvn/wrapper/maven-wrapper.jar

# ==========================================
# Frontend (Angular / Node)
# ==========================================
frontend/node_modules/
frontend/dist/
frontend/.angular/
node_modules/
dist/
.angular/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
