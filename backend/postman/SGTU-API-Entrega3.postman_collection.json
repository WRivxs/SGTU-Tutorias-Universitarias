              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token_estudiante}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Hacker\",\n  \"apellido\": \"Prueba\",\n  \"correo\": \"hacker@tutorias.com\",\n  \"password\": \"Clave123*\",\n  \"rol\": \"ADMINISTRADOR\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/usuarios",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios"]
            }
          }
        },
        {
          "name": "04. Validación 400 Bad Request por campos obligatorios",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "",
                  "pm.test(\"Retorna mapa con detalle de errores de validación\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(400);",
                  "    pm.expect(json).to.have.property(\"errores\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"correo-sin-formato-valido\",\n  \"password\": \"\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
          "name": "05. Recurso No Encontrado (404 Not Found)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});",
                  "",
                  "pm.test(\"Mensaje legible de recurso no encontrado\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.status).to.eql(404);",
                  "    pm.expect(json.error).to.eql(\"Not Found\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token_admin}}" }
            ],
            "url": {
              "raw": "{{base_url}}/api/materias/999999",
              "host": ["{{base_url}}"],
              "path": ["api", "materias", "999999"]
            }
