{
  "info": {
    "name": "SGTU API - Entrega 3 (Seguridad + RBAC)",
    "description": "Colección completa para pruebas de API del Sistema de Gestión de Tutorías Universitarias (SGTU). Incluye autenticación JWT, control de acceso RBAC para Administrador, Tutor y Estudiante, y más de 14 tests automatizados.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00. Autenticación (Login)",
      "item": [
        {
          "name": "01. Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code es 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Respuesta contiene token JWT\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property(\"token\");",
                  "    pm.expect(json.token).to.be.a(\"string\");",
                  "    pm.expect(json.tipo).to.eql(\"Bearer\");",
                  "    pm.environment.set(\"token_admin\", json.token);",
                  "});",
                  "",
                  "pm.test(\"Rol devuelto es ADMINISTRADOR\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.rol).to.eql(\"ADMINISTRADOR\");",
                  "});",
                  "",
                  "pm.test(\"Tiempo de respuesta < 2000ms\", function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@tutorias.com\",\n  \"password\": \"Admin123*\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
        {
