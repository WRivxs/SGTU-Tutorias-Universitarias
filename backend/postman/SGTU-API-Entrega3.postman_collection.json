  },
  "item": [
    {
      "name": "00. Autenticación (Login JWT)",
      "description": "Pruebas de emisión de tokens JWT para los tres roles institucionales y manejo de credenciales inválidas.",
      "item": [
        {
          "name": "01. Login Administrador",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 200 OK', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Respuesta contiene token JWT válido', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('token');",
                  "    pm.expect(json.token).to.be.a('string');",
                  "    pm.expect(json.tipo).to.eql('Bearer');",
                  "    pm.environment.set('token_admin', json.token);",
                  "});",
                  "pm.test('Rol institucional es ADMINISTRADOR', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.rol).to.eql('ADMINISTRADOR');",
                  "});",
                  "pm.test('Tiempo de respuesta adecuado', function () {",
                  "    pm.expect(pm.response.responseTime).to.be.below(15000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@tutorias.com\",\n  \"password\": \"Admin123*\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          }
        },
