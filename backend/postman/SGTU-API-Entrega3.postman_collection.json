        {
          "name": "04. Login Fallido (Credenciales Inválidas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code es 401 Unauthorized', function () {",
                  "    pm.response.to.have.status(401);",
                  "});",
                  "pm.test('Estructura de error estándar RFC 7807', function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.have.property('status', 401);",
                  "    pm.expect(json).to.have.property('error', 'Unauthorized');",
                  "    pm.expect(json).to.have.property('message');",
                  "});"
                ]
              }
            }
